{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Compilers and flags of the activated platform (exported by activate.sh)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "CXX": "$penv{GYSELA_CXX_COMPILER}",
        "CC": "$penv{GYSELA_C_COMPILER}",
        "FC": "$penv{GYSELA_Fortran_COMPILER}",
        "CXXFLAGS": "$penv{GYSELA_CXX_FLAGS}",
        "LDFLAGS": "$penv{GYSELA_EXE_LINKER_FLAGS}"
      },
      "cacheVariables": {
        "CMAKE_CXX_EXTENSIONS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GYSELALIBXX_ACTIVATE_RESTART_TESTS": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -O1 $penv{GYSELA_CXX_FLAGS_DEBUG}",
        "GYSELALIBXX_ACTIVATE_RESTART_TESTS": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Debug with code coverage",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-g -Og --coverage -fprofile-update=atomic",
        "GYSELALIBXX_ACTIVATE_RESTART_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "coverage", "configurePreset": "coverage" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "output": { "outputOnFailure": true } }
  ]
}
